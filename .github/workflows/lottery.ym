name: Lao Lottery Formula Lab

on:
  workflow_dispatch:
  schedule:
    # เวลาไทย = UTC+7
    - cron: "15 0 * * *"    # 07:15 น. สร้าง/ล็อกคำทายงวดวันนี้ก่อนออกผล
    - cron: "45 14 * * *"   # 21:45 น. ดึงผลหลังออก เทียบแพ้ชนะ แล้วล็อกคำทายงวดถัดไป
    - cron: "30 16 * * *"   # 23:30 น. สำรอง เผื่อเว็บต้นทางอัปเดตช้า

permissions:
  contents: write

concurrency:
  group: lao-lottery-update
  cancel-in-progress: false

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-ci.txt

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements-ci.txt

      - name: Run tests (ตรวจว่าไม่มีการแอบดูอนาคต)
        run: python -m unittest discover -s tests -v

      - name: Fetch results
        continue-on-error: true      # ถ้าเว็บต้นทางล่ม ยังสร้างเว็บ/คำทายต่อได้
        run: python thaiorc_import.py --pages 100

      - name: Check locked predictions against real results
        run: python check_results.py

      - name: Lock next-draw prediction (ไม่เขียนทับของเดิม)
        run: python make_prediction.py

      - name: Build website
        run: python build_site.py

      - name: Commit data and site
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data docs
          if git diff --cached --quiet; then
            echo "No changes."
          else
            git commit -m "Update results, predictions and site [skip ci]"
            git pull --rebase origin "${GITHUB_REF_NAME}"
            git push
          fi
